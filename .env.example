# Copy to .env and fill in. Never commit the real .env.

# Postgres password (used by db and backend)
DB_PASSWORD=driperska

# JWT signing secret — MUST be at least 32 bytes. Generate e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-this-must-be-at-least-32-bytes-long!!

# Host port the public site (nginx) is exposed on
WEB_PORT=8080

# First admin account seeded on an empty database (change the password after first login)
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@driperska.local
APP_ADMIN_PASSWORD=changeit123
