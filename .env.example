# Copy to .env. Never commit the real file.
#
# Most of these can also be changed at runtime in the admin panel (Ustawienia → „Konfiguracja (.env)”,
# and Ustawienia AI in the „AI” tab). A value saved there overrides this file and survives a restart;
# „przywróć z .env” drops the override. The exceptions are listed under „Tylko .env” in the panel —
# JWT_SECRET, MEDIA_DIR, DDRAGON_*, APP_ADMIN_* are read once at startup and need a restart.
APP_VERSION=0.4.5
APP_PUBLIC_URL=https://driperska.pl
WEB_PORT=18080

# Generate: openssl rand -base64 36
DB_PASSWORD=replace-with-a-long-random-password

# Generate: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes

APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@driperska.pl

# Production Tournament API key. Never commit the real value.
# Leave empty and set RIOT_MOCK=true to test the whole flow without real Riot accounts.
RIOT_API_KEY=replace-with-production-riot-api-key
RIOT_PLATFORM=eun1
RIOT_PROVIDER_REGION=EUNE
RIOT_REGIONAL_ROUTE=europe
# Tournament endpoints live on the regional cluster, not the platform host.
RIOT_TOURNAMENT_ROUTE=americas
# true = tournament-stub-v5 (works with dev keys; codes are NOT playable in the live client).
# false = real tournament-v5 (needs a production key with the Tournament product approved).
RIOT_USE_STUB=true
RIOT_CALLBACK_URL=https://driperska.pl/api/v1/riot/tournament/callback
# Fake all Riot calls (lobby code, PUUIDs, match stats) — great for local testing.
RIOT_MOCK=false

# Bot must be present on the guild and able to find members and create DMs.
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
DISCORD_GUILD_ID=replace-with-discord-guild-id
# Channel where the "Udostępnij na Discord" button posts result images (right-click channel → Copy ID).
DISCORD_RESULTS_CHANNEL_ID=replace
# Channel for match-schedule announcements (@everyone). Falls back to the results channel if empty.
DISCORD_ANNOUNCE_CHANNEL_ID=
# Channel with RSVP vote buttons for planned matches (clicks from Discord accounts linked to
# players are counted as votes). Falls back to the announcements channel if empty.
DISCORD_VOTE_CHANNEL_ID=
# Dedicated channel for patch-notes announcements (@everyone).
DISCORD_PATCH_CHANNEL_ID=replace-with-discord-patch-channel-id
# Where the bot reports matches a moderator sent to the approval queue (no @everyone).
# Falls back to the announcements channel if empty; an admins-only channel is the better setup.
DISCORD_MODERATION_CHANNEL_ID=
APP_ADMIN_PASSWORD=replace-with-a-long-admin-password
DDRAGON_SYNC_ON_STARTUP=true

# Ollama Cloud — reads LoL end-game screenshots to auto-fill results (temporary, until Tournament API).
# Create a key at https://ollama.com/settings/keys. OLLAMA_VISION_MODEL must be a vision model
# available in your account (e.g. a qwen*-vl / vision-capable model).
# The "AI" tab lists the models your account exposes and can test one before you switch to it.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=replace-with-ollama-api-key
OLLAMA_VISION_MODEL=replace-with-a-cloud-vision-model
# How long to wait for the model. Raise it for slower models.
OLLAMA_TIMEOUT_SECONDS=240
# Attach labelled champion portraits to each request — the main aid for champion recognition.
OLLAMA_ATLAS_ENABLED=true

# Cloudflare Turnstile — set both to require the captcha on login (leave empty to disable).
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET=replace-with-turnstile-secret

# Seconds a player has for each ban/pick before the timer locks their selection.
DRAFT_STEP_SECONDS=30
# Auto-confirm a drawn squad after this many seconds if voting hasn't resolved. 0 = off.
DRAW_AUTO_CONFIRM_SECONDS=60
