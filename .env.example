# Copy to .env. Never commit the real file.
APP_VERSION=0.1.0
APP_PUBLIC_URL=https://driperska.pl
WEB_PORT=18080

# Generate: openssl rand -base64 36
DB_PASSWORD=replace-with-a-long-random-password

# Generate: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes

APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@driperska.pl
APP_ADMIN_PASSWORD=replace-with-a-long-admin-password
DDRAGON_SYNC_ON_STARTUP=true